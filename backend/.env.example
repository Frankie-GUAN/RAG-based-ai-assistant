# 复制为 backend/.env 后填入真实值。所有项都有默认值，只有 DEEPSEEK_API_KEY 必填。
#
# ⚠️ 这个文件曾经是错的：旧版写的是 GEMINI_API_KEY，
# 而 config.py 读的是 DEEPSEEK_API_KEY —— 照它配置会拿不到 LLM key，
# 表现为每次问答都失败。同时旧版把真实的 MySQL 密码写在这里。

# --- LLM（必填）---
DEEPSEEK_API_KEY=
# OpenAI 兼容接口地址，换模型时改这里
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# --- 联网搜索（可选）---
# 不填则 web_search 工具不可用，其余功能不受影响
SERPAPI_KEY=

# --- 数据库 ---
# 需要自行准备 MySQL 8.0 实例
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=rag_agent

# --- 性能（一般不用改）---
# 启动时预加载 BGE-M3 与精排模型。首次约 1 分钟，但首个请求不用等。
# 只跑测试或内存紧张时设为 false。
PRELOAD_MODELS=true
CONTEXT_TOTAL_TOKENS=32000
HISTORY_WINDOW_SIZE=10

# --- 三层记忆 ---
ENABLE_LONG_TERM_MEMORY=true
# 记忆召回最低相似度。「回答要短一点」对「偏好简短回答」约 0.669，
# 所以不要用 0.95 这种常见值，否则几乎召不回。
MEMORY_RECALL_MIN_SCORE=0.55

ENABLE_SEMANTIC_CACHE=true
# 缓存命中阈值。0.85 会把「活跃变量分析怎么定义」与「…能用来做什么」
# （相似度 0.899）判成同一个问题；0.90 是实测权衡后的值。
SEMANTIC_CACHE_THRESHOLD=0.90
SEMANTIC_CACHE_TTL_HOURS=168

# --- Agent ---
# 规划节点多一次 LLM 往返，换取更准的「要不要检索」判定
ENABLE_PLANNING=true
AGENT_MAX_ITERATIONS=8

# --- 检索 ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
HYBRID_TOP_K=10
ENABLE_RERANKER=true
# 跨语言术语改写（只作用于 BM25 一路）
ENABLE_QUERY_REWRITE=true
