__pycache__/
*.py[cod]

# Virtual env
.venv/

# Env secrets
.env
.env.*

# Local data/cache
data/chroma/
# 索引备份（app.rag.ingest --fresh 留下的旧格式索引，可能是唯一的副本，留在本机）
data/chroma.bak.*/
data/uploads/
data/models/
